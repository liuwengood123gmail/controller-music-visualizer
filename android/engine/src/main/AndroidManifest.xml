<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 播放采集（AudioPlaybackCapture）需要录音权限 + 用户同意屏幕录制 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- A 档：手柄的震动和灯 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.LIGHTS" />
    <!-- B 档：Android 17 的原始 HID 访问（危险级，运行时申请） -->
    <uses-permission android:name="android.permission.ACCESS_HID" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application>
        <!-- exported 只为了 adb 调试入口；要求 DUMP 权限（adb shell 有，普通 App 没有），本 App 自己调用不受影响 -->
        <service
            android:name=".EngineService"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:foregroundServiceType="mediaPlayback|mediaProjection" />
    </application>
</manifest>
